meta {
  name: Register Customer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{customerUsername}}",
    "email": "{{customerEmail}}",
    "password": "{{customerPassword}}"
  }
}